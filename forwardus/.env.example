# 세션(로그인) 서명 키. 반드시 넣으세요. 비우면 코드의 공개된 기본값을 쓰는데,
# 그러면 누구나 로그인 쿠키를 만들어 다른 사람 계정으로 들어올 수 있습니다.
# 만드는 법: python -c "import secrets; print(secrets.token_hex(32))"
# 사람마다·서버마다 다른 값을 씁니다. 배포 서버에는 환경변수로 넣습니다.
SECRET_KEY=
DATABASE_URL=
SCHEDULE_API_KEY=
TRACKING_API_KEY=
CUSTOMS_API_KEY=
EXCHANGE_API_KEY=
AI_API_KEY=
# 사진·스캔 서류의 계좌번호를 가리는 Tesseract OCR 실행 파일.
# 비우면 PATH와 C:\Program Files\Tesseract-OCR\tesseract.exe 에서 찾습니다.
# 세관장확인대상물품(관세법 제226조) 조회 키.
# UNI-PASS가 아니라 공공데이터포털에서 받습니다: https://www.data.go.kr/data/15101589/openapi.do
# 둘 중 아무 이름이나 됩니다. 새로 적으실 때는 아래 이름을 쓰세요.
DATA_PORTAL_KEY_CUSTOMS=
# (예전 이름. DATA_PORTAL_KEY_CUSTOMS 가 비어 있을 때만 씁니다)
UNIPASS_KEY_CUSTOMS=
TESSERACT_CMD=
# 한글(kor) 학습 자료를 둔 폴더. 비우면 data/tessdata → 설치 폴더 순서로 씁니다.
TESSDATA_DIR=
# HS 품목분류에만 쓰는 모형. 비우면 gpt-4o를 씁니다.
# 분류를 틀리면 관세포탈이 되는 자리라 상담용보다 나은 모형을 씁니다.
AI_HS_MODEL=
# 올린 서류(오퍼시트)를 읽는 모형. 비우면 gpt-4o. 스캔 사진을 읽으려면 그림을 보는 모형이어야 합니다.
AI_DOC_MODEL=

# 아직 코드에서 읽지 않는 키들. 받아 두기만 한 상태입니다.
# 쓰려면 config.py에 같은 이름으로 선언해야 합니다.
# 이름은 영문 대문자와 밑줄만 씁니다. 한글 이름은 dotenv가 그 줄을 통째로 버립니다.
AVIATIONSTACK_API_KEY=
CUSTOMS_TRADE_STATS_SERVICE_KEY=
MOF_VESSEL_SCHEDULE_SERVICE_KEY=
OPEN_EXCHANGE_RATES_APP_ID=

# Optional
FLASK_DEBUG=0
PORT=5000
EXCHANGE_RATE_USD_KRW=1380

# UNI-PASS (관세청) OpenAPI — 서비스별 인증키
# HS CODE 내비게이션
UNIPASS_KEY_HS_NAVIGATION=
# HS부호검색
UNIPASS_KEY_HS_CODE_SEARCH=
# 간이정액적용비적용업체조회
UNIPASS_KEY_SIMPLE_REFUND_COMPANY=
# 간이정액환급율표조회
UNIPASS_KEY_SIMPLE_REFUND_RATE=
# 검사검역내역조회
UNIPASS_KEY_INSPECTION_QUARANTINE=
# 관세율기본조회
UNIPASS_KEY_TARIFF_RATE=
# 관세환율정보조회
UNIPASS_KEY_CUSTOMS_EXCHANGE_RATE=
# 선박회사내역조회
UNIPASS_KEY_SHIPPING_COMPANY_DETAIL=
# 선박회사목록조회
UNIPASS_KEY_SHIPPING_COMPANY_LIST=
# 수출신고번호별수출이행내역조회
UNIPASS_KEY_EXPORT_PERFORMANCE_BY_DECLARATION=
# 수출신고필증검증
UNIPASS_KEY_EXPORT_DECLARATION_VERIFY=
# 수출이행기간단축대상품목조회
UNIPASS_KEY_EXPORT_PERIOD_SHORTENING_ITEM=
# 수출이행내역차대번호조회
UNIPASS_KEY_EXPORT_PERFORMANCE_BY_VIN=
# 수출입신고 첨부서류사후제출 유무
UNIPASS_KEY_DECLARATION_ATTACHMENT_SUBMISSION=
# 수출입신고서 정정신청 처리상태 제공
UNIPASS_KEY_DECLARATION_CORRECTION_STATUS=
# 수출입요건승인내역조회
UNIPASS_KEY_REQUIREMENT_APPROVAL=
# 입출항보고내역조회
UNIPASS_KEY_ENTRY_DEPARTURE_REPORT=
# 입항보고내역조회(항공)
UNIPASS_KEY_ARRIVAL_REPORT_AIR=
# 입항보고내역조회(해상)
UNIPASS_KEY_ARRIVAL_REPORT_SEA=
# 재수출 이행 완료보고 처리정보 제공
UNIPASS_KEY_REEXPORT_COMPLETION_REPORT=
# 재수출 조건부 수입의 수출이행 기한 정보제공
UNIPASS_KEY_REEXPORT_CONDITIONAL_IMPORT_DEADLINE=
# 재수출면세이행잔량조회
UNIPASS_KEY_REEXPORT_EXEMPTION_BALANCE=
# 출항허가항공 조회
UNIPASS_KEY_DEPARTURE_PERMIT_AIR=
# 출항허가해상 조회
UNIPASS_KEY_DEPARTURE_PERMIT_SEA=
# 컨테이너내역조회
UNIPASS_KEY_CONTAINER_DETAIL=
# 통계부호내역조회
UNIPASS_KEY_STATISTICS_CODE=
# 통관고유부호조회
UNIPASS_KEY_CUSTOMS_CLEARANCE_CODE=
# 항공사내역조회
UNIPASS_KEY_AIRLINE_DETAIL=
# 항공사목록조회
UNIPASS_KEY_AIRLINE_LIST=
# 화물운송주선업자내역조회
UNIPASS_KEY_FORWARDER_DETAIL=
# 화물운송주선업자목록조회
UNIPASS_KEY_FORWARDER_LIST=
# 화물통관진행정보조회
UNIPASS_KEY_CARGO_CLEARANCE_PROGRESS=

# --- 사진·스캔 서류 읽기 (Tesseract OCR) ---------------------------------------
# 사진·스캔 PDF의 글자를 우리 컴퓨터에서 읽습니다. 인터넷으로 보내지 않습니다.
# 계좌번호를 그림에서 칠하는 데에도 씁니다. OCR이 없으면 사진은 아예 받지 않습니다.
#
# 설치
#   1) 프로그램   Windows: winget install UB-Mannheim.TesseractOCR
#                 macOS:   brew install tesseract
#                 Ubuntu:  sudo apt install tesseract-ocr
#   2) 언어 데이터 python data/setup_tessdata.py      (kor·eng, 약 37MB · git에 넣지 않습니다)
#   3) 파이썬 패키지 pip install -r requirements.txt   (pytesseract)
#
# 아래 두 줄은 비워 두면 흔한 설치 경로와 프로젝트의 data/tessdata를 알아서 찾습니다.
# 다른 곳에 설치했을 때만 적으세요.
TESSERACT_CMD=
TESSDATA_DIR=
